# Optional for local development only. Hosted backends use their secret settings.
# If copied to backend/.env, that file is ignored by Git and must never be committed.
OPENAI_API_KEY=replace_with_your_openai_api_key

# Comma-separated browser origins allowed to call the local backend.
# FRONTEND_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
